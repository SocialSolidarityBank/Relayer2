# 릴레이어 환경 변수 보기. 이 파일을 `.env` 로 복사해서 쓴다.
#
#   cp .env.example .env
#
# 값은 여기 적지 않는다. 이 저장소는 공개다.
#
# 소개 페이지와 가이드(`site/`)만 고치는 사람은 이 파일이 필요 없다.
# 정적 파일이라 서버 없이 열린다(docs/site.md 의 "보기").

# ── 앱을 돌리려면 이 둘이 있어야 한다. 없으면 뜨지 않는다 ──
# 내 기기용 값은 직접 만든다. 운영 값을 받아 쓰지 않는다.
#   PII_ENC_KEY:    openssl rand -base64 32
#   SESSION_SECRET: openssl rand -hex 32
# PII_ENC_KEY 는 base64 로 정확히 32바이트다. 잃으면 그 DB 의 자유 글과 금고를 못 읽는다.
PII_ENC_KEY=
SESSION_SECRET=

# ── DB. 비워 두면 로컬 docker(`pnpm db:up`)를 본다 ──
# postgres://relayer:relayer@localhost:55432/relayer
DATABASE_URL=

# ── 있으면 좋고 없어도 도는 것 ──
# 열쇠가 없으면 그 기능이 503 으로 정확히 실패한다. 없는 것을 있는 것처럼 답하지 않는다.
PORT=8787
# AI 정리. openai 또는 azure
AI_PROVIDER=openai
OPENAI_API_KEY=
# 음성 전사. VOICE_ENABLED 를 켜면 동의 셋에 음성 항목이 나온다
VOICE_ENABLED=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ── 배포에서만 쓰는 것 ──
# 기관 주소의 라벨. 화면의 `주소` 행에 읽기 전용으로 보인다
RELAYER_SLUG=
# 있으면 slug 대신 이 주소를 보여 준다. 예: https://yeondae.relayer.kr
RELAYER_PUBLIC_URL=
